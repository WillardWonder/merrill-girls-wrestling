# Client-visible Firebase web configuration. These values identify the Firebase app;
# Firestore Security Rules and Authentication enforce access.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_STORAGE_BUCKET=replace-me.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# demo: uses the in-browser demo repository and synthetic data.
# firebase: uses Firebase Authentication and Cloud Firestore.
VITE_DATA_MODE=demo
VITE_FIREBASE_USE_EMULATORS=false

# Optional. Add only after App Check is registered and monitored.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Build metadata set by CI when available.
VITE_BUILD_SHA=local
VITE_RELEASE_CHANNEL=development

# Optional custom base. Normally leave blank; GitHub Actions derives /REPOSITORY/.
# Set to / only for a root user site or custom domain if automatic detection is not appropriate.
VITE_BASE_PATH=
