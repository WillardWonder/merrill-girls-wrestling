{
  "name": "merrill-girls-wrestling-athlete-development",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:firebase": "vite --mode firebase",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-merrill-girls-wrestling --only auth,firestore \"vitest run tests/rules\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:rules && npm run test:e2e && npm run build",
    "emulators": "firebase emulators:start --project demo-merrill-girls-wrestling --import=.firebase-data --export-on-exit=.firebase-data",
    "emulators:fresh": "firebase emulators:start --project demo-merrill-girls-wrestling",
    "seed:emulator": "tsx scripts/seed-dev.ts --emulator",
    "seed:project": "tsx scripts/seed-dev.ts",
    "provision": "tsx scripts/provision-users.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "deactivate": "tsx scripts/deactivate-user.ts",
    "export:season": "tsx scripts/export-season.ts",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:firebase": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "dependencies": {
    "firebase": "12.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "axe-core": "4.10.3",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "6.0.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "firebase-admin": "13.4.0",
    "firebase-tools": "14.15.2",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "@eslint/js": "9.34.0",
    "globals": "16.3.0",
    "typescript-eslint": "8.41.0"
  }
}
