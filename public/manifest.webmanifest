{
  "name": "Merrill Girls Wrestling",
  "short_name": "Merrill Wrestling",
  "description": "Daily athlete-development tools for Merrill Girls Wrestling.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#06111f",
  "theme_color": "#06111f",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#/app/today", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Practice focus", "url": "./#/app/practice/before/current", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compete", "url": "./#/app/competition", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
